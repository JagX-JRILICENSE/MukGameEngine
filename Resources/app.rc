#include <winver.h>

#define VER_MAJOR 0
#define VER_MINOR 11
#define VER_PATCH 0

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Muk Game Engine"
            VALUE "FileDescription", "Muk Game Engine Editor"
            VALUE "FileVersion", "0.11.0"
            VALUE "InternalName", "MukEditor"
            VALUE "LegalCopyright", "MIT"
            VALUE "OriginalFilename", "MukEditor.exe"
            VALUE "ProductName", "Muk Game Engine"
            VALUE "ProductVersion", "0.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
